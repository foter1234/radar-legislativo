{
  "name": "radar-legislativo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Acompanhe o Congresso: pauta, votações, votos de cada parlamentar, presença e proposições.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/index.js",
    "sync": "node server/sync.js",
    "test": "node --test \"server/test/*.test.js\"",
    "web:install": "npm --prefix web install",
    "web:build": "npm --prefix web run build",
    "web:dev": "npm --prefix web run dev",
    "test:web": "npm --prefix web test",
    "check": "npm test && npm --prefix web run build && npm run test:web"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "pg": "^8.23.1"
  }
}
